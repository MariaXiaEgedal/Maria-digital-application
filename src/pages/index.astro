---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Hero from "../components/Hero.astro";
import WhoAmI from "../components/WhoAmI.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
---

<MainLayout title="Maria Xia Egedal - Multimediedesigner">
  <!--------------------------- 1) HERO --------------------------->
  <Hero
    imageSrc="/img/maria-lyserod.webp"
    imageAlt="Maria foran bygning"
    titleTop="MARIA XIA"
    titleBottom="EGEDAL"
    subtitle="Multimediedesigner"
  />
  <!--------------------------- 2) HVEM ER JEG --------------------------->

  <WhoAmI />

  <!--------------------------- 3) PROJEKTER --------------------------->
  <section id="projects">
    <Projects />
  </section>

  <!-- Decorative Lines -->
  <section class="flex flex-col gap-3 mt-10 md:mb-40 md:mt-30">
    <div class="h-3 md:h-6 bg-rose-beige ml-auto w-4/7"></div>
    <div class="h-3 md:h-6 bg-chestnut ml-auto w-3/7"></div>
    <div class="h-3 md:h-6 bg-brown ml-auto w-[90%]"></div>
  </section>

  <!--------------------------- 4) KOMPETENCER --------------------------->
  <section id="skills">
    <Skills />
  </section>
</MainLayout>
